{
    "service_dependencies_directory": "__services__",
    "metadata_dependencies_directory": "__metadata__",
    "blocks_directory": "__block__",
    "dependencies": {
        "PF_POSTGRES": "dependencies/pf-postgres"
    },
    "dependencies_env": true,
    "include": [
        "app",
        "bootstrap",
        "config",
        "database",
        "public",
        "resources",
        "routes",
        "artisan",
        "composer.json",
        "composer.lock",
        ".service/pack_config.json"
    ],
    "ignore": [
        "vendor/",
        "node_modules/",
        "tests/",
        "storage/",
        "*.md",
        ".env",
        ".env.*",
        ".git/",
        ".github/",
        "docker/",
        "docker-compose.yml",
        ".editorconfig",
        ".pytest_cache/",
        "__pycache__/",
        "bootstrap/cache/*.php"
    ]
}
